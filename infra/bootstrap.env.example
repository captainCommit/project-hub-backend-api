# Copy to infra/bootstrap.env (git-ignored) and fill in. Read by scripts/bootstrap-account.sh.
# Empty values are skipped, so the matching feature stays off. Everything Terraform creates (database URLs,
# Cognito IDs and secret, deploy roles, OAuth state secret) is read from its outputs instead.

# --- GitHub variables (API repo, environment = stage) ----------------------------------------------------------
# CloudWatch alarm inbox; confirm the SNS subscription email after the first deploy.
ALARM_EMAIL=
# Must be verified in SES (terraform var ses_email_identities), e.g. Project Hub <notifications@example.com>
EMAIL_FROM=
# Optional extra Cognito app clients allowed to call the API (comma separated).
COGNITO_ADDITIONAL_CLIENT_IDS=
# Stripe price IDs (scripts/setup_stripe_prices.py, scripts/setup_stripe_ai_usage.py). Same Stripe account,
# same IDs.
STRIPE_FULL_SEAT_PRICE_ID=
STRIPE_VIEWER_SEAT_PRICE_ID=
STRIPE_AI_USAGE_PRICE_ID=
# Public app IDs; their secrets go below.
SLACK_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# Leave empty: read from the serverless stack's AppUrl output once the API has deployed. Set it only to override.
APP_URL=

# --- SSM SecureStrings (/project-hub/<stage>/...) -------------------------------------------------------------
# Stripe: the webhook secret belongs to one endpoint, so create a new endpoint for <APP_URL>/api/v1/billing/stripe-webhook
# and use its secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
MICROSOFT_CLIENT_SECRET=
# Platform-provided AI models.
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_GEMINI_API_KEY=
