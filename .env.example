APP_NAME=Project Hub API
ENVIRONMENT=local
AUTH_MODE=local
AWS_REGION=ca-central-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_hub
CORS_ORIGINS=http://localhost:3000

