APP_NAME=Project Hub API
ENVIRONMENT=local
AUTH_MODE=local
APP_AWS_REGION=ca-central-1
S3_BUCKET_NAME=
ATTACHMENT_UPLOAD_EXPIRES_SECONDS=900
ATTACHMENT_DOWNLOAD_EXPIRES_SECONDS=900
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Comma-separated extra app clients whose tokens are accepted (e.g. the UI public client)
COGNITO_ADDITIONAL_CLIENT_IDS=
# Browser sign-in: hosted login domain and the app client's secret (the API exchanges codes).
COGNITO_DOMAIN=https://your-domain.auth.ca-central-1.amazoncognito.com
COGNITO_APP_CLIENT_SECRET=
# Deployed only: read the client secret from this SSM SecureString instead.
# COGNITO_APP_CLIENT_SECRET_PARAM=/project-hub/dev/cognito-app-client-secret
# Session cookies are always HttpOnly + SameSite=Strict. Keep Secure on; browsers accept
# Secure cookies on http://localhost, so it only needs turning off for other plain-http hosts.
SESSION_COOKIE_SECURE=true
COGNITO_INVITE_ENABLED=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_hub
CORS_ORIGINS=http://localhost:3000

# AWS RDS/Aurora PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:your-password@your-rds-endpoint.region.rds.amazonaws.com:5432/project_hub
# RDS hosts always connect with sslmode=verify-full. Set DATABASE_IAM_AUTH=true to sign in with an IAM token instead of a password.
# DATABASE_IAM_AUTH=false